<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <KsaDir Condition="'$(KsaDir)' == ''">$(KSA_GAME_DIR)</KsaDir>
    <LoaderDir Condition="'$(LoaderDir)' == ''">$(KSA_LOADER_DIR)</LoaderDir>
    <LoaderDir Condition="'$(LoaderDir)' == ''">$(MSBuildThisFileDirectory)..\..\.tools\StarMap-0.4.8</LoaderDir>
    <PluginDir Condition="'$(PluginDir)' == ''">$(MSBuildThisFileDirectory)..\..\work\build\KsaBabel</PluginDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="KsaBabel"><HintPath>$(PluginDir)\KsaBabel.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="KSA"><HintPath>$(KsaDir)\KSA.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.Localization"><HintPath>$(KsaDir)\Brutal.Localization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.ImGui"><HintPath>$(KsaDir)\Brutal.ImGui.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(LoaderDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="RequireGameDirectory" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(KsaDir)' == ''" Text="Set KSA_GAME_DIR or pass -p:KsaDir=&lt;game directory&gt;; no local game path is assumed." />
    <Error Condition="!Exists('$(KsaDir)/KSA.dll')" Text="KSA.dll was not found under KsaDir. Supply a valid local KSA installation." />
  </Target>
</Project>
